---
import Layout from "../layouts/Layout.astro";
import { getAllComponents, getBuckets } from "../lib/components";

const components = getAllComponents();
const buckets = getBuckets();
---

<Layout title={`Component Gallery (${components.length})`}>
  <header class="sticky top-0 z-10 border-b border-neutral-200 bg-neutral-50/90 backdrop-blur dark:border-neutral-800 dark:bg-neutral-950/90">
    <div class="mx-auto max-w-7xl px-4 py-4">
      <div class="flex items-center justify-between gap-4">
        <h1 class="text-lg font-semibold">
          Component Gallery <span class="text-neutral-400 dark:text-neutral-500" id="result-count">({components.length})</span>
        </h1>
        <button
          id="theme-toggle"
          type="button"
          class="rounded-md border border-neutral-300 px-2 py-1 text-sm dark:border-neutral-700"
          aria-label="Toggle dark mode"
        >
          <span class="dark:hidden">🌙 Dark</span>
          <span class="hidden dark:inline">☀️ Light</span>
        </button>
      </div>

      <div class="mt-3 flex flex-col gap-3 sm:flex-row sm:items-center">
        <input
          id="search"
          type="search"
          placeholder="Search by name, author, or bucket…"
          class="w-full rounded-md border border-neutral-300 bg-white px-3 py-2 text-sm outline-none focus:border-neutral-500 dark:border-neutral-700 dark:bg-neutral-900 sm:max-w-md"
          autofocus
        />
        <div id="bucket-chips" class="flex flex-wrap gap-1 text-xs">
          <button data-bucket="" class="bucket-chip rounded border border-neutral-300 px-2 py-1 dark:border-neutral-700" aria-pressed="true">
            all
          </button>
          {
            buckets.map((b) => (
              <button data-bucket={b} class="bucket-chip rounded border border-neutral-300 px-2 py-1 dark:border-neutral-700" aria-pressed="false">
                {b}
              </button>
            ))
          }
        </div>
      </div>

      <div id="recent-wrap" class="mt-3 hidden">
        <div class="text-xs uppercase tracking-wide text-neutral-400 dark:text-neutral-500">Recently viewed</div>
        <div id="recent-list" class="mt-1 flex flex-wrap gap-2 text-xs"></div>
      </div>
    </div>
  </header>

  <main class="mx-auto max-w-7xl px-4 py-6">
    <p id="empty-state" class="hidden py-16 text-center text-neutral-400 dark:text-neutral-500">
      No components match your search.
    </p>
    <div id="grid" class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6">
      {
        components.map((c) => (
          <a
            href={`/component/${c.slug}/`}
            class="card group flex flex-col overflow-hidden rounded-lg border border-neutral-200 bg-white transition hover:border-neutral-400 dark:border-neutral-800 dark:bg-neutral-900 dark:hover:border-neutral-600"
            data-search={c.searchText}
            data-bucket={c.bucket}
          >
            <div class="aspect-video w-full overflow-hidden bg-neutral-100 dark:bg-neutral-800">
              <img
                src={c.screenshotUrl}
                alt={`${c.componentName} screenshot`}
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover object-top transition group-hover:scale-105"
              />
            </div>
            <div class="flex flex-1 flex-col gap-0.5 p-2.5">
              <div class="truncate text-sm font-medium">{c.componentName}</div>
              <div class="flex items-center justify-between gap-2 text-xs text-neutral-500 dark:text-neutral-400">
                <span class="truncate">{c.authorName}</span>
                <span class="shrink-0 rounded bg-neutral-100 px-1.5 py-0.5 uppercase dark:bg-neutral-800">{c.bucket}</span>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </main>

  <script>
    const searchInput = document.getElementById("search") as HTMLInputElement;
    const cards = Array.from(document.querySelectorAll<HTMLAnchorElement>(".card"));
    const grid = document.getElementById("grid")!;
    const emptyState = document.getElementById("empty-state")!;
    const resultCount = document.getElementById("result-count")!;
    const bucketChips = Array.from(document.querySelectorAll<HTMLButtonElement>(".bucket-chip"));

    let activeBucket = "";

    function applyFilter() {
      const query = searchInput.value.trim().toLowerCase();
      let visible = 0;
      for (const card of cards) {
        const matchesSearch = !query || card.dataset.search!.includes(query);
        const matchesBucket = !activeBucket || card.dataset.bucket === activeBucket;
        const show = matchesSearch && matchesBucket;
        card.classList.toggle("hidden", !show);
        if (show) visible++;
      }
      resultCount.textContent = `(${visible})`;
      emptyState.classList.toggle("hidden", visible !== 0);
      grid.classList.toggle("hidden", visible === 0);
    }

    searchInput.addEventListener("input", applyFilter);

    for (const chip of bucketChips) {
      chip.addEventListener("click", () => {
        activeBucket = chip.dataset.bucket ?? "";
        for (const c of bucketChips) c.setAttribute("aria-pressed", String(c === chip));
        applyFilter();
      });
    }

    // Keyboard nav: arrow keys move focus between visible cards in the grid.
    grid.addEventListener("keydown", (e) => {
      if (!["ArrowRight", "ArrowLeft", "ArrowDown", "ArrowUp"].includes(e.key)) return;
      const visibleCards = cards.filter((c) => !c.classList.contains("hidden"));
      const currentIndex = visibleCards.indexOf(document.activeElement as HTMLAnchorElement);
      if (currentIndex === -1) return;
      e.preventDefault();

      const columns = Math.max(
        1,
        Math.round(grid.clientWidth / (visibleCards[0]?.clientWidth || grid.clientWidth))
      );
      let nextIndex = currentIndex;
      if (e.key === "ArrowRight") nextIndex++;
      else if (e.key === "ArrowLeft") nextIndex--;
      else if (e.key === "ArrowDown") nextIndex += columns;
      else if (e.key === "ArrowUp") nextIndex -= columns;

      const next = visibleCards[Math.min(Math.max(nextIndex, 0), visibleCards.length - 1)];
      next?.focus();
    });

    // Theme toggle
    const themeToggle = document.getElementById("theme-toggle")!;
    themeToggle.addEventListener("click", () => {
      const isDark = document.documentElement.classList.toggle("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
    });

    // Recently viewed strip, read from localStorage (written by the detail page).
    try {
      const recent: { slug: string; name: string }[] = JSON.parse(localStorage.getItem("recentlyViewed") || "[]");
      if (recent.length > 0) {
        const wrap = document.getElementById("recent-wrap")!;
        const list = document.getElementById("recent-list")!;
        for (const item of recent) {
          const a = document.createElement("a");
          a.href = `/component/${item.slug}/`;
          a.textContent = item.name;
          a.className =
            "rounded border border-neutral-300 px-2 py-1 hover:border-neutral-500 dark:border-neutral-700 dark:hover:border-neutral-500";
          list.appendChild(a);
        }
        wrap.classList.remove("hidden");
      }
    } catch {
      // localStorage unavailable or corrupt — ignore, it's just a convenience strip.
    }
  </script>
</Layout>
