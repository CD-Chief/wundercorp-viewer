---
import Layout from "../../layouts/Layout.astro";
import { getAllComponents, getPromptText, getGithubReadmeUrl } from "../../lib/components";

export function getStaticPaths() {
  return getAllComponents().map((component) => ({
    params: { slug: component.slug },
    props: { component },
  }));
}

const { component } = Astro.props;
const promptText = getPromptText(component);
const githubUrl = getGithubReadmeUrl(component);
---

<Layout title={`${component.componentName} — ${component.authorName}`}>
  <header class="border-b border-neutral-200 bg-neutral-50/90 backdrop-blur dark:border-neutral-800 dark:bg-neutral-950/90">
    <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-4">
      <a href="/" class="text-sm text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100">← Back to gallery</a>
      <button
        id="theme-toggle"
        type="button"
        class="rounded-md border border-neutral-300 px-2 py-1 text-sm dark:border-neutral-700"
        aria-label="Toggle dark mode"
      >
        <span class="dark:hidden">🌙 Dark</span>
        <span class="hidden dark:inline">☀️ Light</span>
      </button>
    </div>
  </header>

  <main
    class="mx-auto max-w-7xl px-4 py-6"
    data-slug={component.slug}
    data-name={component.componentName}
  >
    <div class="mb-4">
      <h1 class="text-xl font-semibold">{component.componentName}</h1>
      <p class="text-sm text-neutral-500 dark:text-neutral-400">
        by {component.authorName} · variant <code class="rounded bg-neutral-100 px-1 dark:bg-neutral-800">{component.variantName}</code> · bucket
        <code class="rounded bg-neutral-100 px-1 dark:bg-neutral-800">{component.bucket}</code>
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-5">
      <div class="lg:col-span-3">
        <div class="mb-2 flex items-center justify-between">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-neutral-500 dark:text-neutral-400">Rendered preview</h2>
          <a href={component.screenshotUrl} target="_blank" rel="noopener" class="text-xs text-neutral-500 hover:underline dark:text-neutral-400">
            view screenshot
          </a>
        </div>
        <div class="overflow-hidden rounded-lg border border-neutral-200 bg-white dark:border-neutral-800 dark:bg-neutral-900">
          <iframe
            src={component.htmlUrl}
            title={`${component.componentName} rendered preview`}
            sandbox="allow-scripts"
            loading="lazy"
            class="h-[600px] w-full bg-white"
          ></iframe>
        </div>
        <p class="mt-2 text-xs text-neutral-400 dark:text-neutral-500">
          Preview is sandboxed (scripts allowed for animations/interactions, but no same-origin access to this app) since it's arbitrary third-party HTML.
        </p>
      </div>

      <div class="lg:col-span-2">
        <div class="mb-2 flex items-center justify-between">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-neutral-500 dark:text-neutral-400">Prompt</h2>
          <div class="flex items-center gap-3">
            <a href={githubUrl} target="_blank" rel="noopener" class="text-xs text-neutral-500 hover:underline dark:text-neutral-400">
              source on GitHub
            </a>
            <button
              id="copy-prompt"
              type="button"
              class="rounded-md border border-neutral-300 px-2 py-1 text-xs dark:border-neutral-700"
            >
              Copy prompt
            </button>
          </div>
        </div>
        <details open class="rounded-lg border border-neutral-200 bg-white dark:border-neutral-800 dark:bg-neutral-900">
          <summary class="cursor-pointer select-none px-3 py-2 text-sm font-medium">prompt.md</summary>
          <pre id="prompt-text" class="max-h-[600px] overflow-auto whitespace-pre-wrap break-words border-t border-neutral-200 p-3 text-xs dark:border-neutral-800">{promptText || "(no prompt.md found for this variant)"}</pre>
        </details>
      </div>
    </div>
  </main>

  <script>
    const themeToggle = document.getElementById("theme-toggle")!;
    themeToggle.addEventListener("click", () => {
      const isDark = document.documentElement.classList.toggle("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
    });

    const copyBtn = document.getElementById("copy-prompt")!;
    const promptEl = document.getElementById("prompt-text")!;
    copyBtn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(promptEl.textContent || "");
        const original = copyBtn.textContent;
        copyBtn.textContent = "Copied!";
        setTimeout(() => (copyBtn.textContent = original), 1200);
      } catch {
        // Clipboard API unavailable (e.g. insecure context) — user can still select + copy manually.
      }
    });

    // Track recently viewed in localStorage for the homepage strip.
    try {
      const main = document.querySelector("main")!;
      const slug = main.dataset.slug!;
      const name = main.dataset.name!;
      const MAX_RECENT = 10;
      const recent: { slug: string; name: string }[] = JSON.parse(localStorage.getItem("recentlyViewed") || "[]");
      const filtered = recent.filter((r) => r.slug !== slug);
      filtered.unshift({ slug, name });
      localStorage.setItem("recentlyViewed", JSON.stringify(filtered.slice(0, MAX_RECENT)));
    } catch {
      // localStorage unavailable — recently-viewed is just a convenience feature.
    }
  </script>
</Layout>
